{
    "version": 2,
    "builds": [
      { "src": "server.js", "use": "@vercel/node" }
    ],
    "routes": [
      { "src": "/public/(.*)", "dest": "/public/$1" },
      { "src": "/(.*)",        "dest": "server.js" }
    ],
    "crons": [
      {
        "path": "/api/cron/account-action-jobs",
        "schedule": "0 0 * * *"
      }
    ]
  }
